# Site
NEXT_PUBLIC_SITE_URL=https://www.shutterbugcamerashop.com
NEXT_PUBLIC_AMAZON_STORE_URL=https://www.amazon.com/shops/shutterbugcamera

# PostgreSQL (Supabase, Neon, Prisma Postgres, or another Vercel-compatible Postgres host)
# Use DATABASE_URL for app runtime. For Supabase, this can be the shared transaction-mode pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true
# Optional but recommended for Prisma migrations. For Supabase, use the session/direct connection.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Simple admin auth
ADMIN_EMAIL=fregoli90@yahoo.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Customer account auth
CUSTOMER_SESSION_SECRET=replace-with-another-long-random-secret
EMAIL_FROM="Shutterbug Camera Shop <support@shutterbugcamerashop.com>"
ADMIN_ORDER_EMAIL=fregoli90@yahoo.com
RESEND_API_KEY=re_xxx

# Stripe Checkout
STRIPE_SECRET_KEY=sk_live_or_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal (reserved for Phase 3 PayPal checkout)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=shutterbug-products
CLOUDINARY_TRADE_IN_FOLDER=shutterbug-trade-ins

# Trade-in notifications and optional store-credit promotion
ADMIN_TRADE_IN_EMAIL=fregoli90@yahoo.com
TRADE_IN_PROMOTION_ENABLED=true
TRADE_IN_PROMOTION_ID=store-credit-bonus
TRADE_IN_CREDIT_BONUS_PERCENT=10
TRADE_IN_PROMOTION_LABEL="Get 10% more in store credit"
TRADE_IN_PROMOTION_DESCRIPTION="Choose store credit after inspection and we will add the current bonus to your final cash value."
# Optional ISO-8601 bounds; omit for an always-active promotion.
# TRADE_IN_PROMOTION_STARTS_AT=2026-06-01T00:00:00-04:00
# TRADE_IN_PROMOTION_ENDS_AT=2026-09-01T00:00:00-04:00
