generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

enum ProductCondition {
  NEW
  OPEN_BOX
  USED_EXCELLENT
  USED_GOOD
  USED_FAIR
  FOR_PARTS
}

enum CameraType {
  VINTAGE_DIGITAL
  FILM_CAMERA
  ACCESSORY
  PARTS_REPAIR
}

enum CameraFormat {
  DIGITAL
  FILM
  ACCESSORY
}

enum ProductImageRole {
  HERO
  GALLERY
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TradeInStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_DECLINED
  SHIPPING_ARRANGED
  RECEIVED
  INSPECTING
  REVISED_OFFER_SENT
  COMPLETED
  CANCELLED
}

enum TradeInItemType {
  DIGITAL_CAMERA
  FILM_CAMERA
  LENS
  ACCESSORY
  COLLECTION
  OTHER
}

enum TradeInCondition {
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  FOR_PARTS
  UNKNOWN
}

enum TradeInPayoutMethod {
  CASH
  STORE_CREDIT
}

enum TradeInOfferKind {
  INITIAL
  REVISED
}

enum TradeInOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum TradeInHistoryActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

model Product {
  id                String           @id @default(cuid())
  sku               String?          @unique
  gtin              String?
  mpn               String?
  slug              String           @unique
  title             String
  brand             String
  manufacturer      String           @default("")
  model             String
  categorySlug      String
  categorySlugs     String[]         @default([])
  subcategorySlug   String           @default("")
  productType       String           @default("")
  cameraType        CameraType       @default(VINTAGE_DIGITAL)
  format            CameraFormat     @default(DIGITAL)
  condition         ProductCondition @default(USED_GOOD)
  functionalStatus  String           @default("Tested")
  testedStatus      String           @default("Tested")
  conditionSummary  String           @default("")
  conditionNotes    String           @default("")
  priceCents        Int
  quantity          Int              @default(1)
  status            ProductStatus    @default(DRAFT)
  description       String           @default("")
  shortDescription  String           @default("")
  seoTitle          String?
  seoDescription    String           @default("")
  tags              String[]         @default([])
  lensMount         String           @default("")
  filmFormat        String           @default("")
  storageType       String           @default("")
  reservedQuantity  Int              @default(0)
  includesBattery   Boolean          @default(false)
  includesCharger   Boolean          @default(false)
  includesMemoryCard Boolean         @default(false)
  includesCase      Boolean          @default(false)
  includesStrap     Boolean          @default(false)
  includesManual    Boolean          @default(false)
  includesOriginalBox Boolean        @default(false)
  actualPhotos      Boolean          @default(false)
  samplePhotos      Boolean          @default(false)
  partsRepair       Boolean          @default(false)
  forPartsOrRepair  Boolean          @default(false)
  featured          Boolean          @default(false)
  newArrival        Boolean          @default(false)
  badges            String[]         @default([])
  included          String[]         @default([])
  doesNotInclude    String[]         @default([])
  tested            String[]         @default([])
  goodFor           String[]         @default([])
  cosmeticNotes     String[]         @default([])
  functionalNotes   String[]         @default([])
  flaws             String[]         @default([])
  notes             String[]         @default([])
  shippingNote      String           @default("")
  returnsNote       String           @default("")
  checkoutUrl       String?
  mainImageUrl      String           @default("")
  imageUrls         String[]         @default([])
  images            ProductImage[]
  customerLikes     CustomerProductLike[]
  orderItems        OrderItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([slug])
  @@index([status])
  @@index([brand])
  @@index([categorySlug])
  @@index([subcategorySlug])
  @@index([productType])
  @@index([functionalStatus])
  @@index([featured])
  @@index([newArrival])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String           @default("")
  role      ProductImageRole @default(GALLERY)
  sortOrder Int              @default(0)
  publicId  String?
  createdAt DateTime         @default(now())

  @@index([productId, role, sortOrder])
}

model Customer {
  id                      String                           @id @default(cuid())
  email                   String                           @unique
  passwordHash            String
  name                    String?
  emailVerifiedAt         DateTime?
  emailVerificationTokens CustomerEmailVerificationToken[]
  productLikes            CustomerProductLike[]
  modelWatches            CustomerModelWatch[]
  orders                  Order[]
  tradeIns                TradeInSubmission[]
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  @@index([email])
}

model TradeInSubmission {
  id                    String                @id @default(cuid())
  reference             String                @unique
  customerId            String
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status                TradeInStatus         @default(DRAFT)
  itemType              TradeInItemType?
  brand                 String                @default("")
  model                 String                @default("")
  modelUnknown          Boolean               @default(false)
  quantity              Int                   @default(1)
  condition             TradeInCondition?
  powersOn              Boolean?
  functionalNotes       String                @default("")
  cosmeticNotes         String                @default("")
  includedItems         String[]              @default([])
  additionalNotes       String                @default("")
  payoutPreference      TradeInPayoutMethod?
  phone                 String                @default("")
  localHandoffRequested Boolean               @default(false)
  shippingInstructions  String                @default("")
  inboundCarrier        String                @default("")
  inboundTracking       String                @default("")
  adminNotes            String                @default("")
  finalPayoutCents      Int?
  submittedAt           DateTime?
  completedAt           DateTime?
  images                TradeInImage[]
  offers                TradeInOffer[]
  history               TradeInStatusEvent[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([customerId, createdAt])
  @@index([status, updatedAt])
  @@index([reference])
}

model TradeInImage {
  id                 String            @id @default(cuid())
  tradeInId          String
  tradeIn            TradeInSubmission @relation(fields: [tradeInId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String
  cloudinaryVersion  Int
  format             String
  mimeType           String
  bytes              Int
  width              Int?
  height             Int?
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())

  @@index([tradeInId, sortOrder])
}

model TradeInOffer {
  id               String             @id @default(cuid())
  tradeInId        String
  tradeIn          TradeInSubmission  @relation(fields: [tradeInId], references: [id], onDelete: Cascade)
  kind             TradeInOfferKind   @default(INITIAL)
  status           TradeInOfferStatus @default(PENDING)
  cashCents        Int
  storeCreditCents Int
  note             String             @default("")
  expiresAt        DateTime?
  respondedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tradeInId, createdAt])
  @@index([status, expiresAt])
}

model TradeInStatusEvent {
  id        String              @id @default(cuid())
  tradeInId String
  tradeIn   TradeInSubmission   @relation(fields: [tradeInId], references: [id], onDelete: Cascade)
  actor     TradeInHistoryActor @default(SYSTEM)
  status    TradeInStatus
  message   String
  createdAt DateTime            @default(now())

  @@index([tradeInId, createdAt])
}

model CustomerEmailVerificationToken {
  id        String    @id @default(cuid())
  customerId String
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerProductLike {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
}

model CustomerModelWatch {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  key          String
  brand        String
  model        String
  categorySlug String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([customerId, key])
  @@index([customerId, createdAt])
  @@index([key])
}
model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  guestAccessToken  String?            @unique
  customerId        String?
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail     String
  customerName      String?
  customerPhone     String?
  shippingAddress   Json?
  billingAddress    Json?
  provider          PaymentProvider    @default(STRIPE)
  providerReference String?            @unique
  stripeCheckoutSessionId String?      @unique
  stripePaymentIntentId String?        @unique
  stripeRefundId       String?         @unique
  customerEmailSendingAt DateTime?
  customerEmailSentAt DateTime?
  adminEmailSendingAt DateTime?
  adminEmailSentAt DateTime?
  status            OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus      @default(PENDING)
  fulfillmentStatus FulfillmentStatus  @default(UNFULFILLED)
  currency          String             @default("USD")
  subtotalCents     Int
  shippingCents     Int                @default(0)
  taxCents          Int                @default(0)
  totalCents        Int
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  adminNotes        String?
  processingAt      DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?
  paidAt            DateTime?
  shippingEmailSendingAt DateTime?
  shippingEmailSentAt DateTime?
  reservationExpiresAt DateTime?
  inventoryReleasedAt DateTime?
  notes             String?
  items             OrderItem[]
  history           OrderStatusEvent[]
  createdAt         DateTime           @default(now())
  stripeEvents      StripeWebhookEvent[]
  updatedAt         DateTime           @updatedAt

  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([status])
  @@index([customerId])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug    String
  productSku     String   @default("")
  productTitle   String
  conditionLabel String
  imageUrl       String?
  quantity       Int
  unitPriceCents Int
  totalPriceCents Int
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  processedAt DateTime @default(now())

  @@index([orderId])
}
